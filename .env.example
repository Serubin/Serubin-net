# Next.js and portfolio CLI scripts (`fetch:portfolio`, `warm:portfolio`) load the same `.env*`
# files from the project root; see scripts/loadScriptEnv.ts.

# HttpOnly portfolio_view cookie signing secret (see middleware). Required in production.
# In development, a fixed fallback is used if unset.
PORTFOLIO_COOKIE_SECRET=

# Optional: HTTPS URL to a ZIP. Album folders may be at the zip root (MyAlbum/photo.jpg) or
# under one top-level folder (MyExport/MyAlbum/photo.jpg); a single wrapper is hoisted automatically.
# When set, `yarn start` replaces images/portfolio with the archive before warming the cache.
# PORTFOLIO_SOURCE_ZIP_URL=

# Optional: sent as Authorization: Bearer <token> when fetching the ZIP.
# PORTFOLIO_SOURCE_AUTH_TOKEN=

# Verbose fetch/extract logs (per-entry paths, temp file). Logs omit URL query strings.
# PORTFOLIO_FETCH_DEBUG=1
